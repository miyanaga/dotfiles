# 対話シェルのたびに読まれる設定（フレームワーク不使用）

# --- PATH ---------------------------------------------------------------
# 基本は .zprofile で設定されるが、.zshrc しか読まれない環境への保険
typeset -U path PATH          # PATHの重複エントリを自動排除
if [[ -x /opt/homebrew/bin/brew && -z "${HOMEBREW_PREFIX:-}" ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
fi
path=("$HOME/.local/bin" $path)

# --- 履歴 ---------------------------------------------------------------
HISTFILE="$HOME/.zsh_history"
HISTSIZE=100000
SAVEHIST=100000
setopt SHARE_HISTORY          # 複数ターミナル間で履歴を共有
setopt HIST_IGNORE_ALL_DUPS   # 重複コマンドは古い方を消す
setopt HIST_IGNORE_SPACE      # 先頭スペースのコマンドは履歴に残さない

bindkey -e                    # emacsキーバインド

# --- 補完（部分一致対応） ---------------------------------------------------
autoload -Uz compinit && compinit
# 大文字小文字を無視し、単語の先頭以外（部分一致）でもマッチさせる
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' 'r:|[._-]=* r:|=*' 'l:|=* r:|=*'
zstyle ':completion:*' menu select   # Tab連打で候補をメニュー選択

# --- mise (node / go などのランタイム管理) ----------------------------------
command -v mise >/dev/null && eval "$(mise activate zsh)"

# --- エイリアス -----------------------------------------------------------
alias cc="claude --dangerously-skip-permissions"
alias ts="/Applications/Tailscale.app/Contents/MacOS/Tailscale"   # Tailscale CLI

# --- プラグイン（brew install zsh-autosuggestions zsh-history-substring-search）
# 入力中、履歴からの候補をグレーで先読み表示（→キーで確定）
if [[ -f /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]]; then
  source /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh
  ZSH_AUTOSUGGEST_STRATEGY=(history completion)  # 履歴になければ補完候補からも提案
fi
# 途中の文字列でも一致する履歴を ↑/↓ で検索（部分一致検索）
if [[ -f /opt/homebrew/share/zsh-history-substring-search/zsh-history-substring-search.zsh ]]; then
  source /opt/homebrew/share/zsh-history-substring-search/zsh-history-substring-search.zsh
  bindkey '^[[A' history-substring-search-up
  bindkey '^[[B' history-substring-search-down
fi

# --- プロンプト（調整は starship/starship.toml で行う） ----------------------
if command -v starship >/dev/null; then
  eval "$(starship init zsh)"
else
  # starship未導入でも最低限のプロンプト（カレントディレクトリ + gitブランチ）
  autoload -Uz vcs_info
  precmd() { vcs_info }
  zstyle ':vcs_info:git:*' formats ' (%b)'
  setopt PROMPT_SUBST
  PROMPT='%F{cyan}%~%f%F{yellow}${vcs_info_msg_0_}%f %# '
fi

# --- シークレット（APIキー等）: git管理外・chmod 600 -------------------------
[[ -f "$HOME/.zsh_secrets" ]] && source "$HOME/.zsh_secrets"

# --- マシン固有の設定（git管理外） -------------------------------------------
[[ -f "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"
