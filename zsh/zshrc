# 対話シェルのたびに読まれる設定（フレームワーク不使用）

# --- PATH ---------------------------------------------------------------
# 基本は .zprofile で設定されるが、.zshrc しか読まれない環境への保険
typeset -U path PATH          # PATHの重複エントリを自動排除
if [[ -x /opt/homebrew/bin/brew && -z "${HOMEBREW_PREFIX:-}" ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
fi
path=("$HOME/.local/bin" $path)

# --- 履歴 ---------------------------------------------------------------
HISTFILE="$HOME/.zsh_history"
HISTSIZE=100000
SAVEHIST=100000
setopt SHARE_HISTORY          # 複数ターミナル間で履歴を共有
setopt HIST_IGNORE_ALL_DUPS   # 重複コマンドは古い方を消す
setopt HIST_IGNORE_SPACE      # 先頭スペースのコマンドは履歴に残さない

bindkey -e                    # emacsキーバインド

# --- 補完（部分一致対応） ---------------------------------------------------
autoload -Uz compinit && compinit
# 大文字小文字を無視し、単語の先頭以外（部分一致）でもマッチさせる
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' 'r:|[._-]=* r:|=*' 'l:|=* r:|=*'
zstyle ':completion:*' menu select   # Tab連打で候補をメニュー選択

# --- mise (node / go などのランタイム管理) ----------------------------------
command -v mise >/dev/null && eval "$(mise activate zsh)"

# --- エイリアス -----------------------------------------------------------
alias cc="claude --dangerously-skip-permissions"
# Tailscale CLI。macOSのアプリ版はappバンドルの中、Linuxは普通にPATHに入る。
if [[ -x /Applications/Tailscale.app/Contents/MacOS/Tailscale ]]; then
  alias ts="/Applications/Tailscale.app/Contents/MacOS/Tailscale"
elif command -v tailscale >/dev/null; then
  alias ts="tailscale"
fi
# z [path ...] - Zedを新規ウィンドウで開く（パスが存在しなければ mkdir -p で作成）
z() {
  local arg
  for arg in "$@"; do
    [[ "$arg" == -* ]] && continue          # オプションはスキップ
    if [[ ! -e "$arg" ]]; then
      mkdir -p "$arg" || return 1
      echo "z: created $arg"
    fi
  done
  zed -n "$@"
}
(( $+functions[compdef] )) && compdef '_files -/' z

# w [dir] - 指定ディレクトリ（省略時はカレント）でWezTermを新規ウィンドウで開く
w() {
  local dir="${1:-$PWD}"
  if [[ ! -d "$dir" ]]; then
    echo "w: not a directory: $dir" >&2
    return 1
  fi
  dir="${dir:A}"   # 絶対パスに正規化
  if [[ -n "$WEZTERM_UNIX_SOCKET" ]]; then
    # WezTerm内から: 既存プロセスに新規ウィンドウを生やす
    wezterm cli spawn --new-window --cwd "$dir" >/dev/null
  else
    # WezTerm外から: GUIを新規に起動する
    wezterm start --cwd "$dir" >/dev/null 2>&1 &!
  fi
}
(( $+functions[compdef] )) && compdef '_files -/' w

# --- ユーティリティ関数（scode/scursor/szed等） ------------------------------
[[ -f "$HOME/.zsh_functions" ]] && source "$HOME/.zsh_functions"

# --- プラグイン ------------------------------------------------------------
# macOS: brew install zsh-autosuggestions zsh-history-substring-search
# Ubuntu: sudo apt install zsh-autosuggestions zsh-syntax-highlighting
#         （history-substring-search はaptに無いので手動でcloneする）
# 置き場所がOSで違うので、候補を順に見て最初に見つかったものを読む。
_load_zsh_plugin() {  # _load_zsh_plugin <プラグイン名> <ファイル名>
  local dir
  for dir in "${HOMEBREW_PREFIX:-/opt/homebrew}/share/$1" \
             /usr/share/zsh-plugins/"$1" \
             /usr/share/"$1" \
             "$HOME/.zsh/$1"; do
    if [[ -f "$dir/$2" ]]; then
      source "$dir/$2"
      return 0
    fi
  done
  return 1
}

# 入力中、履歴からの候補をグレーで先読み表示（→キーで確定）
if _load_zsh_plugin zsh-autosuggestions zsh-autosuggestions.zsh; then
  ZSH_AUTOSUGGEST_STRATEGY=(history completion)  # 履歴になければ補完候補からも提案
fi
# 途中の文字列でも一致する履歴を ↑/↓ で検索（部分一致検索）
if _load_zsh_plugin zsh-history-substring-search zsh-history-substring-search.zsh; then
  bindkey '^[[A' history-substring-search-up
  bindkey '^[[B' history-substring-search-down
fi
unfunction _load_zsh_plugin

# --- プロンプト（調整は starship/starship.toml で行う） ----------------------
if command -v starship >/dev/null; then
  eval "$(starship init zsh)"
else
  # starship未導入でも最低限のプロンプト（カレントディレクトリ + gitブランチ）
  autoload -Uz vcs_info
  precmd() { vcs_info }
  zstyle ':vcs_info:git:*' formats ' (%b)'
  setopt PROMPT_SUBST
  PROMPT='%F{cyan}%~%f%F{yellow}${vcs_info_msg_0_}%f %# '
fi

# --- シークレット（APIキー等）: git管理外・chmod 600 -------------------------
[[ -f "$HOME/.zsh_secrets" ]] && source "$HOME/.zsh_secrets"

# --- マシン固有の設定（git管理外） -------------------------------------------
[[ -f "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"
